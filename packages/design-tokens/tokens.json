  "$meta": {
    "derivation": "OKLCH via Ottosson OKLab<->sRGB matrices, binary-search gamut mapping. Contrast: WCAG 2.1 + APCA W3-0.1.9. CVD: Brettel/Vienot.",
    "accentHue": 142,
    "neutralHue": 264,
    "hueSeparation": 122,
    "neutralCurve": "L = 0.215 + 0.770 * t^1.40, steps 600/700 lifted for AA — see src/derive-neutrals.mjs",
    "lightCurve": "L = 0.985 - 0.840 * t^1.55"
  },


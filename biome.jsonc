{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!packages/design-tokens/tokens.json",
      "!apps/web/src/components/ui",
      // The menu bar's design doc is a static illustration of a SwiftUI
      // panel, not the UI: its markup is drawn to be LOOKED at, and a11y
      // rules written for shipped components only produce noise here.
      // `_mockup.css` is generated by `pnpm tokens` besides, for the same
      // reason Tokens.swift is generated into apps/macos: a browser opening a
      // file from disk cannot reach the gitignored dist/.
      "!docs/design",
      // A design review's pick (.claude/skills/design-review), for the same
      // reason: a mockup to be looked at, with the tokens inlined.
      "!specs/*/design",
      // Regenerated by `next dev` on every run and explicitly marked
      // "should not be edited" — formatting it is a fight with the codegen.
      "!apps/web/next-env.d.ts",
      // The favicon, generated by `pnpm tokens` into the path Next resolves
      // by file convention. A browser rasterizes it into tab chrome, where it
      // never enters the accessibility tree, so the `<title>` a11y rule wants
      // would only add bytes to every request — the tab's own text is the
      // accessible name.
      "!apps/web/src/app/icon.svg",
      // MSW's service worker, written by `msw init` and replaced on upgrade.
      "!apps/web/.storybook/public/mockServiceWorker.js",
      "!**/dist",
      "!**/.next",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "off",
        // The only index-keyed lists here are invoice line items, which are
        // frozen at generation and never reorder — the index IS their stable
        // identity. Re-enable if a reorderable list is ever added.
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}

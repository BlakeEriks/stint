  "contract": {
    "$comment": "Asserted in CI. A token change breaking these must fail the build.",
    "assertions": [
      { "fg": "neutral.850", "bg": "neutral.25", "min": 4.5, "note": "body text dark" },
      { "fg": "neutral.600", "bg": "neutral.25", "min": 4.5, "note": "muted floor dark" },
      { "fg": "accent.300",  "bg": "neutral.25", "min": 4.5, "note": "accent on bg" },
      { "fg": "neutral.0",   "bg": "accent.300", "min": 4.5, "note": "THE regression to guard: never white here (1.37)" },
      { "fg": "neutral.500", "bg": "neutral.25", "min": 3.0, "note": "control border dark" },
      { "fg": "lightNeutral.850", "bg": "lightNeutral.0", "min": 4.5, "note": "body text light" },
      { "fg": "lightNeutral.600", "bg": "lightNeutral.0", "min": 4.5, "note": "muted floor light" },
      { "fg": "#1F7E17", "bg": "lightNeutral.0", "min": 4.5, "note": "light accent" },
      { "fg": "#FFFFFF", "bg": "#1F7E17", "min": 4.5, "note": "text on light accent" },
      { "fg": "neutral.0", "bg": "#E9504D", "min": 4.5, "note": "text on danger dark (white is 3.67 here)" },
      { "fg": "#FFFFFF", "bg": "#C21725", "min": 4.5, "note": "text on danger light (near-black is 3.25 here)" }
    ],
    "forbidden": [
      { "fg": "#FFFFFF", "bg": "accent.300", "reason": "1.37:1 - catastrophic. Use text-on-accent (neutral.0)." },
      { "fg": "neutral.500", "bg": "neutral.25", "asText": true, "reason": "4.10:1 fails AA. text-subtle is NON-TEXT only." }
    ]
  },

  "type": {
    "fontFamily": {
      "sans": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "timer":     { "family": "mono", "size": 30,   "weight": 500, "tracking": "-0.02em", "tabular": true },
      "title":     { "family": "sans", "size": 28,   "weight": 600, "tracking": "-0.02em" },
      "section":   { "family": "sans", "size": 18,   "weight": 500 },
      "body":      { "family": "sans", "size": 15,   "weight": 400 },
      "duration":  { "family": "mono", "size": 14,   "weight": 400, "tabular": true },
      "meta":      { "family": "mono", "size": 11.5, "weight": 400 },
      "label":     { "family": "mono", "size": 11,   "weight": 500, "tracking": "0.16em", "uppercase": true },
      "menubar":   { "family": "mono", "size": 13,   "weight": 400, "tabular": true }
    }
  },

  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 3, "md": 6, "lg": 8, "xl": 10, "full": 999 }

  "contract": {
    "$comment": "Asserted in CI. A token change breaking these must fail the build. Every `bg` here is the CARD surface (bg-elevated: neutral.50 dark, lightNeutral.0 light), because that is what text is read on. They used to name neutral.25 / lightNeutral.0 as 'the background' from a two-plane era; once the frame grew to four planes neutral.25 became the content COLUMN, so the dark assertions were proving a ratio against a surface no text sits on.",
    "assertions": [
      { "fg": "neutral.850", "bg": "neutral.50", "min": 4.5, "note": "body text dark" },
      { "fg": "neutral.600", "bg": "neutral.50", "min": 4.5, "note": "muted floor dark" },
      { "fg": "accent.300",  "bg": "neutral.50", "min": 4.5, "note": "accent on the card" },
      { "fg": "neutral.0",   "bg": "accent.300", "min": 4.5, "note": "THE regression to guard: never white here (1.37)" },
      { "fg": "neutral.500", "bg": "neutral.50", "min": 4.5, "note": "subtle text dark — AA, because the app sets body copy in it" },
      { "fg": "neutral.400", "bg": "neutral.50", "min": 3.0, "note": "control border dark" },
      { "fg": "neutral.700", "bg": "neutral.50", "min": 3.0, "note": "focus ring dark — neutral, NOT the accent (see principles)" },
      { "fg": "lightNeutral.850", "bg": "lightNeutral.0", "min": 4.5, "note": "body text light" },
      { "fg": "lightNeutral.600", "bg": "lightNeutral.0", "min": 4.5, "note": "muted floor light" },
      { "fg": "lightNeutral.500", "bg": "lightNeutral.0", "min": 4.5, "note": "subtle text light — AA, because the app sets body copy in it" },
      { "fg": "lightNeutral.400", "bg": "lightNeutral.0", "min": 3.0, "note": "control border light" },
      { "fg": "lightNeutral.700", "bg": "lightNeutral.0", "min": 3.0, "note": "focus ring light" },
      { "fg": "#1F7E17", "bg": "lightNeutral.0", "min": 4.5, "note": "light accent" },
      { "fg": "#FFFFFF", "bg": "#1F7E17", "min": 4.5, "note": "text on light accent" },
      { "fg": "neutral.0", "bg": "#E9504D", "min": 4.5, "note": "text on danger dark (white is 3.67 here)" },
      { "fg": "#FFFFFF", "bg": "#C21725", "min": 4.5, "note": "text on danger light (near-black is 3.25 here)" }
    ],
    "forbidden": [
      { "fg": "#FFFFFF", "bg": "accent.300", "reason": "1.37:1 - catastrophic. Use text-on-accent (neutral.0)." }
    ]
  },


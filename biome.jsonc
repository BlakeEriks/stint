{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!packages/design-tokens/tokens.json",
      "!apps/web/src/components/ui",
      // Design docs are static illustrations of the UI, not the UI. Their
      // markup is drawn to be LOOKED at — a mockup's <button> has no type
      // because it has no form, and a11y rules written for shipped
      // components only produce noise here. `_mockup.css` is generated by
      // `pnpm tokens` besides, for the same reason Tokens.swift is generated
      // into apps/macos: a browser opening a file from disk cannot reach the
      // gitignored dist/.
      "!docs/design",
      // Regenerated by `next dev` on every run and explicitly marked
      // "should not be edited" — formatting it is a fight with the codegen.
      "!apps/web/next-env.d.ts",
      "!**/dist",
      "!**/.next"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": "off",
        // The only index-keyed lists here are invoice line items, which are
        // frozen at generation and never reorder — the index IS their stable
        // identity. Re-enable if a reorderable list is ever added.
        "noArrayIndexKey": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}

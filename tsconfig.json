{
  "compilerOptions": {
    "target": "ES2022",
    // TS 6 stopped auto-discovering @types; name what we actually use.
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@stint/core": ["./packages/core/src/index.ts"],
      "@stint/schema": ["./packages/schema/src/index.ts"],
      "@stint/design-tokens": ["./packages/design-tokens/dist/tokens.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "apps"]
}

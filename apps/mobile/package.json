{
  "name": "@stint/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "prestart": "pnpm --filter @stint/design-tokens build",
    "start": "expo start",
    "preweb": "pnpm --filter @stint/design-tokens build",
    "web": "expo start --web",
    "pretypecheck": "pnpm --filter @stint/design-tokens build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "pretest:stories": "pnpm --filter @stint/design-tokens build",
    "test:stories": "vitest run",
    "eas-build-post-install": "pnpm --filter @stint/design-tokens build"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~58.0.15",
    "@stint/client": "workspace:*",
    "@stint/core": "workspace:*",
    "@stint/design-tokens": "workspace:^",
    "@stint/schema": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "typescript": "^6.0.3"
  }
}

{
  "name": "@stint/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${PORT:-3100}",
    "predev": "pnpm --filter @stint/design-tokens build",
    "build": "next build",
    "prebuild": "pnpm --filter @stint/design-tokens build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "detox": "node scripts/shadcn-detox.mjs --check 'src/components/ui/*.tsx'",
    "check:type": "node scripts/check-type-roles.mjs 'src/**/*.tsx' '../macos/Sources/**/*.swift'",
    "pretest": "pnpm --filter @stint/design-tokens build",
    "test": "node --test --test-concurrency=1 --experimental-strip-types --import ./test/loader-register.mjs test/routes.test.ts test/invoices.test.ts test/rates.test.ts test/mocks-parity.test.ts",
    "pretest:ui": "pnpm --filter @stint/design-tokens build",
    "test:ui": "vitest run --project ui",
    "pretest:stories": "pnpm --filter @stint/design-tokens build",
    "test:stories": "vitest run --project stories",
    "sample:invoice": "node --experimental-strip-types scripts/render-sample-invoice.mjs",
    "test:rls": "node --test --test-concurrency=1 --experimental-strip-types --import ./test/loader-register.mjs test/rls.test.ts",
    "test:auth": "node --test --test-concurrency=1 --experimental-strip-types --import ./test/loader-register.mjs test/auth.test.ts test/preview-signin.test.ts",
    "test:e2e": "playwright test",
    "prestorybook": "pnpm --filter @stint/design-tokens build",
    "storybook": "storybook dev --port 6006 --no-open",
    "prebuild-storybook": "pnpm --filter @stint/design-tokens build",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@stint/core": "workspace:*",
    "@stint/design-tokens": "workspace:^",
    "@stint/schema": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "jsdom": "^30.1.0",
    "mockdate": "^3.0.5",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "pg": "^8.13.1",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "typescript": "^6.0.3",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  }
}

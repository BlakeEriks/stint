<?xml version="1.0" encoding="utf-8"?>
<!-- The project line, or a failed press's reason in its place. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout android:id="@+id/detail_row" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/project_dot" android:layout_width="8dp"
            android:layout_height="8dp" android:layout_marginEnd="6dp"
            android:src="@drawable/stint_disc" android:importantForAccessibility="no" />
        <TextView android:id="@+id/detail" android:textColor="#A0A7B4" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_mono_400" android:maxLines="1"
            android:textSize="11.5sp" />
    </LinearLayout>
    <TextView android:id="@+id/why" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:ellipsize="end"
        android:fontFamily="@font/ibm_plex_mono_400" android:maxLines="1"
        android:textSize="11.5sp" android:visibility="gone" />
</FrameLayout>

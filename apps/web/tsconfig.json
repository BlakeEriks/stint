{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // No baseUrl: deprecated in TS 6, removed in 7. The paths below are
    // already relative to this file, so it was redundant.
    "paths": {
      "@/*": ["./src/*"],
      "@stint/core": ["../../packages/core/src/index.ts"],
      "@stint/schema": ["../../packages/schema/src/index.ts"],
      "@stint/design-tokens": ["../../packages/design-tokens/dist/tokens.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

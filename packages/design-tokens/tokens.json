  "contract": {
    "$comment": "Asserted in CI. A token change breaking these must fail the build.",
    "assertions": [
      { "fg": "neutral.850", "bg": "neutral.25", "min": 4.5, "note": "body text dark" },
      { "fg": "neutral.600", "bg": "neutral.25", "min": 4.5, "note": "muted floor dark" },
      { "fg": "accent.300",  "bg": "neutral.25", "min": 4.5, "note": "accent on bg" },
      { "fg": "neutral.0",   "bg": "accent.300", "min": 4.5, "note": "THE regression to guard: never white here (1.37)" },
      { "fg": "neutral.500", "bg": "neutral.25", "min": 3.0, "note": "control border dark" },
      { "fg": "lightNeutral.850", "bg": "lightNeutral.0", "min": 4.5, "note": "body text light" },
      { "fg": "lightNeutral.600", "bg": "lightNeutral.0", "min": 4.5, "note": "muted floor light" },
      { "fg": "#1F7E17", "bg": "lightNeutral.0", "min": 4.5, "note": "light accent" },
      { "fg": "#FFFFFF", "bg": "#1F7E17", "min": 4.5, "note": "text on light accent" },
      { "fg": "neutral.0", "bg": "#E9504D", "min": 4.5, "note": "text on danger dark (white is 3.67 here)" },
      { "fg": "#FFFFFF", "bg": "#C21725", "min": 4.5, "note": "text on danger light (near-black is 3.25 here)" },
      { "fg": "neutral.700", "bg": "neutral.25", "min": 3.0, "note": "focus ring dark — neutral, NOT the accent (see principles)" },
      { "fg": "lightNeutral.600", "bg": "lightNeutral.0", "min": 3.0, "note": "focus ring light" }
    ],
    "forbidden": [
      { "fg": "#FFFFFF", "bg": "accent.300", "reason": "1.37:1 - catastrophic. Use text-on-accent (neutral.0)." },
      { "fg": "neutral.500", "bg": "neutral.25", "asText": true, "reason": "4.10:1 fails AA. text-subtle is NON-TEXT only." }
    ]
  },

  "type": {
    "fontFamily": {
      "sans": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "timer":     { "family": "mono", "size": 24,   "sizeSm": 30, "weight": 500, "tracking": "-0.02em", "tabular": true },
      "title":     { "family": "sans", "size": 24,   "weight": 600, "tracking": "-0.025em" },
      "section":   { "family": "sans", "size": 18,   "weight": 500 },
      "heading":   { "family": "sans", "size": 16.5, "weight": 600, "tracking": "-0.01em" },
      "body":      { "family": "sans", "size": 15,   "weight": 400 },
      "control":   { "family": "sans", "size": 14,   "weight": 400 },
      "support":   { "family": "sans", "size": 13,   "weight": 400 },
      "amount":    { "family": "mono", "size": 15,   "weight": 400, "tabular": true },
      "amount-hero": { "family": "mono", "size": 24, "weight": 500, "tracking": "-0.02em", "tabular": true },
      "duration":  { "family": "mono", "size": 14,   "weight": 400, "tabular": true },
      "meta":      { "family": "mono", "size": 11.5, "weight": 400, "tabular": true },
      "wordmark":  { "family": "mono", "size": 17,   "weight": 600, "tracking": "0.18em", "uppercase": true },
      "nav":       { "family": "mono", "size": 13,   "weight": 500, "tracking": "0.08em", "uppercase": true },
      "label":     { "family": "mono", "size": 11,   "weight": 500, "tracking": "0.16em", "uppercase": true },
      "badge":     { "family": "mono", "size": 9.5,  "weight": 400, "tracking": "0.08em", "uppercase": true }
    }
  },

  "$elevation": "Composite shadow values, not colours, so they live outside `semantic` and pass through the generator untouched. Theme-aware: a dark ground needs a near-opaque shadow to read at all, a light one needs a much softer alpha or it looks like soot.",
  "elevation": {
    "dark": {
      "shadow-card":  "0 1px 2px rgba(0,0,0,0.40), 0 2px 10px rgba(0,0,0,0.34)",
      "shadow-float": "0 2px 4px rgba(0,0,0,0.44), 0 8px 24px rgba(0,0,0,0.40)"
    },
    "light": {
      "shadow-card":  "0 1px 2px rgba(16,18,26,0.06), 0 2px 8px rgba(16,18,26,0.07)",
      "shadow-float": "0 2px 4px rgba(16,18,26,0.08), 0 8px 24px rgba(16,18,26,0.10)"
    }
  },

  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "sm": 3, "md": 6, "lg": 8, "xl": 10, "full": 999 }
}

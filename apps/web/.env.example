# Public — ships in the browser bundle. RLS is what protects the data.
# Dashboard -> Project Settings -> API. Use the PUBLISHABLE key
# (sb_publishable_...), not a secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — superuser Postgres, bypasses RLS. Used only by `pnpm migrate` and
# `pnpm verify:schema`, never by the app. Dashboard -> Project Settings ->
# Database -> Connection string -> Session pooler.
#
# NOT the same as the RLS test connection: `pnpm test:rls` deliberately
# connects as a NON-superuser `authenticated` role, because a superuser
# bypasses RLS and would make that suite pass while proving nothing.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

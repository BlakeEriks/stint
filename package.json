{
  "name": "stint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "pnpm --filter @stint/design-tokens build",
    "tokens:validate": "pnpm --filter @stint/design-tokens validate",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "migrate": "node scripts/migrate.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  }
}

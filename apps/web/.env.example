# Public — these ship in the browser bundle. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — full database access, bypassing RLS. Used only by `pnpm migrate`
# and `pnpm verify:schema`, never by the app. Dashboard -> Project Settings
# -> Database -> Connection string -> Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
